+<?php
+
+namespace App\Http\Controllers\Admin;
+
+use App\Http\Controllers\Controller;
+use App\Models\Signalement;
+use Illuminate\Http\Request;
+use Illuminate\Validation\Rule;
+
+class ModerationController extends Controller
+{
+    public function index()
+    {
+        $signalements = Signalement::with(['rapporteur', 'sujet.auteur', 'reponse.auteur', 'reponse.sujet'])
+            ->orderByRaw("CASE WHEN statut = 'en_attente' THEN 0 ELSE 1 END")
+            ->orderBy('created_at', 'desc')
+            ->get();
+
+        return view('admin.moderation.index', [
+            'signalements' => $signalements,
+            'raisons' => Signalement::raisons(),
+        ]);
+    }
+
+    public function updateStatut(Request $request, $id)
+    {
+        $donnees = $request->validate([
+            'statut' => ['required', Rule::in(['en_attente', 'traite', 'rejete'])],
+        ]);
+
+        Signalement::findOrFail($id)->update(['statut' => $donnees['statut']]);
+
+        return back()->with('succes', 'Signalement mis à jour.');
+    }
+}
