@@ -0,0 +1,50 @@
+<?php
+
+namespace App\Http\Controllers\Admin;
+
+use App\Http\Controllers\Controller;
+use App\Models\Reponse;
+use App\Models\Sujet;
+
+class ForumSujetController extends Controller
+{
+    public function index()
+    {
+        $sujets = Sujet::with(['auteur', 'categorie'])
+            ->withCount(['reponses', 'signalements'])
+            ->orderBy('created_at', 'desc')
+            ->get();
+
+        return view('admin.forum-sujets.index', ['sujets' => $sujets]);
+    }
+
+    public function epingler($id)
+    {
+        $sujet = Sujet::findOrFail($id);
+        $sujet->update(['epingle' => ! $sujet->epingle]);
+
+        return back()->with('succes', $sujet->epingle ? 'Sujet épinglé.' : 'Sujet désépinglé.');
+    }
+
+    public function fermer($id)
+    {
+        $sujet = Sujet::findOrFail($id);
+        $sujet->update(['ferme' => ! $sujet->ferme]);
+
+        return back()->with('succes', $sujet->ferme ? 'Sujet fermé.' : 'Sujet rouvert.');
+    }
+
+    public function destroy($id)
+    {
+        Sujet::findOrFail($id)->delete();
+
+        return back()->with('succes', 'Sujet supprimé.');
+    }
+
+    public function destroyReponse($id)
+    {
+        Reponse::findOrFail($id)->delete();
+
+        return back()->with('succes', 'Réponse supprimée.');
+    }
+}
