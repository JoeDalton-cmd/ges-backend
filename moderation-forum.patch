+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Reponse;
+use App\Models\Signalement;
+use App\Models\Sujet;
+use Illuminate\Http\Request;
+use Illuminate\Validation\Rule;
+
+class SignalementController extends Controller
+{
+    public function signalerSujet(Request $request, $id)
+    {
+        $sujet = Sujet::findOrFail($id);
+
+        $this->enregistrer($request, ['sujet_id' => $sujet->id, 'reponse_id' => null]);
+
+        return redirect('/forum/sujet/' . $sujet->id)->with('succes', 'Merci, ton signalement a été transmis aux modérateurs.');
+    }
+
+    public function signalerReponse(Request $request, $id)
+    {
+        $reponse = Reponse::findOrFail($id);
+
+        $this->enregistrer($request, ['sujet_id' => null, 'reponse_id' => $reponse->id]);
+
+        return redirect('/forum/sujet/' . $reponse->sujet_id)->with('succes', 'Merci, ton signalement a été transmis aux modérateurs.');
+    }
+
+    private function enregistrer(Request $request, array $cible): void
+    {
+        $donnees = $request->validate([
+            'raison' => ['required', Rule::in(array_keys(Signalement::raisons()))],
+            'description' => 'nullable|string|max:500',
+        ]);
+
+        // Un membre ne peut pas signaler deux fois la même chose tant que ce n'est pas traité.
+        Signalement::firstOrCreate(
+            $cible + ['user_id' => auth()->id(), 'statut' => 'en_attente'],
+            ['raison' => $donnees['raison'], 'description' => $donnees['description'] ?? null]
+        );
+    }
+}
