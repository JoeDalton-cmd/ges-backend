@@ -0,0 +1,31 @@
+<?php
+
+namespace App\Http\Controllers\Admin;
+
+use App\Http\Controllers\Controller;
+use App\Models\User;
+
+class MembreController extends Controller
+{
+    public function index()
+    {
+        $membres = User::where('role', 'membre')->orderBy('created_at', 'desc')->get();
+
+        return view('admin.membres.index', ['membres' => $membres]);
+    }
+
+    public function suspendre($id)
+    {
+        $membre = User::findOrFail($id);
+
+        // On ne suspend jamais un administrateur (ni soi-même).
+        if ($membre->role === 'admin' || $membre->id === auth()->id()) {
+            return back()->withErrors(['membre' => "Impossible de suspendre ce compte."]);
+        }
+
+        $membre->suspendu = ! $membre->suspendu;
+        $membre->save();
+
+        return back()->with('succes', $membre->suspendu ? 'Membre suspendu.' : 'Membre réactivé.');
+    }
+}
